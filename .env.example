# Copy to .env for local testing only — never commit a real .env file.

# Preferred: paste the full string from TiDB Cloud's "Connect" panel.
TIDB_CONNECTION_STRING=mysql://user.root:password@gateway01.xx-xxxxx-x.prod.aws.tidbcloud.com:4000/hoster?ssl-mode=VERIFY_IDENTITY

# Fallback (only used if TIDB_CONNECTION_STRING is not set):
# TIDB_HOST=your-cluster.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=your_user
# TIDB_PASSWORD=your_password
# TIDB_DATABASE=hoster
